# =============================================================================
# sn101_edge miner configuration
# =============================================================================
# Source this (or merge into your miner.env / miner.pm2.env) before starting.

# --- LLM ensemble ------------------------------------------------------------
# OpenRouter is preferred. If you only set OPENAI_API_KEY the miner falls back
# to the OpenAI-compatible path automatically.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# SN101_LLM_BASE_URL=https://openrouter.ai/api/v1

# The crowd overwhelmingly runs the reference miner on gpt-4o-mini, so listing
# it twice weights the ensemble toward the distribution consensus is scored
# against. Keep at least one gpt-4o-mini entry.
SN101_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,openai/gpt-4o-mini
SN101_SAMPLES_PER_MODEL=3
SN101_TEMPERATURE=0.9
SN101_LLM_CONCURRENCY=8

# --- Deadlines ---------------------------------------------------------------
# Fractions of the validator's wire timeout. The wire timeout comes from the
# task lease and can be as low as 10s, so leave headroom.
SN101_LLM_BUDGET_FRACTION=0.45
SN101_MIN_LLM_BUDGET=1.5
SN101_SELECT_BUDGET=2.5

# --- Duplicate-penalty model -------------------------------------------------
# Production validator values (from tasks/sn101.py, NOT the README's numbers).
SN101_DUP_K=0.06
SN101_DUP_C=80.0
# Set this near the real miner count on the subnet for accurate collision
# estimates: btcli subnet metagraph --netuid 101
SN101_ASSUMED_MINERS=200

# --- Selection ---------------------------------------------------------------
SN101_SELECT_TOP_K=6
SN101_VERBATIM_BONUS=0.03
SN101_MARGINAL_EPSILON=0.02

# --- Caching -----------------------------------------------------------------
SN101_CACHE_TTL=3600
SN101_CACHE_MAX=2048

# --- Diagnostics -------------------------------------------------------------
# Turn on to log per-task candidate scores. Verbose; use while tuning only.
SN101_DEBUG=false
